{
  "name": "@mpa-forge/platform-frontend-observability",
  "description": "Shared frontend observability runtime and adapters for browser apps in the platform blueprint.",
  "version": "0.1.0",
  "private": false,
  "packageManager": "bun@1.3.11",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/mpa-forge/platform-frontend-observability.git"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./react-router": {
      "types": "./dist/react-router.d.ts",
      "import": "./dist/react-router.js"
    },
    "./frontend-web": {
      "types": "./dist/frontend-web.d.ts",
      "import": "./dist/frontend-web.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/react.tsx src/react-router.tsx src/frontend-web.ts --format esm --dts --splitting false --clean --out-dir dist --tsconfig tsconfig.build.json --external react --external react-dom --external react-router-dom --external web-vitals",
    "lint": "prettier --check .",
    "package:check": "npm pack --dry-run",
    "prepack": "bun run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "web-vitals": "^5.1.0"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.2"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-router-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "tsup": "^8.5.0",
    "prettier": "3.6.2",
    "jsdom": "^27.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.2",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
